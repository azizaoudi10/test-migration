{
  "name": "fraktole",
  "version": "0.15.4",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "dev": "pnpm --filter @fraktole/desktop dev",
    "dist:win": "pnpm --filter @fraktole/desktop dist:win",
    "dist:linux": "pnpm --filter @fraktole/desktop dist:linux"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "esbuild": "catalog:"
  }
}
